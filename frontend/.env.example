# Backend URL.
#   Leave this file out entirely for local development (defaults to http://localhost:5000).
#   Production behind a reverse proxy on the same domain: leave the value empty.
#   Separate API domain: set it, e.g. https://api.example.com
VITE_API_URL=

# Optional WebSocket override (derived automatically when omitted)
# VITE_WS_URL=wss://pulseiq.example.com/ws

# Optional: repository shown in the agent install commands
# VITE_AGENT_REPO_URL=https://github.com/your-user/PulseIQ.git

# VITE_* values are public in the built JavaScript. Never put secrets here.