const db = require('../config/db');
const { runApiTest, validateTest } = require('../services/apiTestRunner.service');

const validId = value =>
    /^\d+$/.test(value) &&
    Number.isSafeInteger(Number(value)) &&
    Number(value) > 0;

function validateDefinition(name, steps) {
    if (typeof name !== 'string' || !name.trim() || name.trim().length > 100) {
        return 'name must be a non-empty string of at most 100 characters';
    }

    if (!Array.isArray(steps) || steps.length < 1 || steps.length > 10) {
        return 'steps must contain between 1 and 10 steps';
    }

    return null;
}

async function listApiTests(req, res) {
    try {
        const result = await db.query(
            `SELECT id, name, steps, created_at, updated_at
             FROM api_tests
             WHERE user_id = $1
             ORDER BY updated_at DESC`,
            [req.user.id]
        );

        return res.json(result.rows);
    } catch {
        return res.status(500).json({ error: 'Failed to list API tests' });
    }
}

async function getApiTest(req, res) {
    if (!validId(req.params.id)) {
        return res.status(400).json({ error: 'Invalid API test ID' });
    }

    try {
        const result = await db.query(
            `SELECT id, name, steps, created_at, updated_at
             FROM api_tests
             WHERE id = $1 AND user_id = $2`,
            [Number(req.params.id), req.user.id]
        );

        if (!result.rows.length) {
            return res.status(404).json({ error: 'API test not found' });
        }

        return res.json(result.rows[0]);
    } catch {
        return res.status(500).json({ error: 'Failed to fetch API test' });
    }
}

async function createApiTest(req, res) {
    const { name, steps } = req.body || {};
    const validationError = validateDefinition(name, steps);

    if (validationError) {
        return res.status(400).json({ error: validationError });
    }

    try {
        // Validate the step definitions before persisting them.
        // No outbound requests are made during validation.
        await validateStepsOnly(steps);

        const result = await db.query(
            `INSERT INTO api_tests (user_id, name, steps)
             VALUES ($1, $2, $3::jsonb)
             RETURNING id, name, steps, created_at, updated_at`,
            [req.user.id, name.trim(), JSON.stringify(steps)]
        );

        return res.status(201).json(result.rows[0]);
    } catch (error) {
        if (error?.code === 'INVALID_API_TEST') {
            return res.status(400).json({ error: error.message });
        }

        return res.status(500).json({ error: 'Failed to create API test' });
    }
}

async function updateApiTest(req, res) {
    if (!validId(req.params.id)) {
        return res.status(400).json({ error: 'Invalid API test ID' });
    }

    const { name, steps } = req.body || {};

    if (name === undefined && steps === undefined) {
        return res.status(400).json({ error: 'Provide a name or steps to update' });
    }

    if (
        name !== undefined &&
        (typeof name !== 'string' || !name.trim() || name.trim().length > 100)
    ) {
        return res.status(400).json({
            error: 'name must be a non-empty string of at most 100 characters'
        });
    }

    if (steps !== undefined) {
        if (!Array.isArray(steps) || steps.length < 1 || steps.length > 10) {
            return res.status(400).json({
                error: 'steps must contain between 1 and 10 steps'
            });
        }

        try {
            await validateStepsOnly(steps);
        } catch (error) {
            if (error?.code === 'INVALID_API_TEST') {
                return res.status(400).json({ error: error.message });
            }

            return res.status(500).json({ error: 'Failed to validate API test' });
        }
    }

    try {
        const result = await db.query(
            `UPDATE api_tests
             SET name = COALESCE($1, name),
                 steps = COALESCE($2::jsonb, steps),
                 updated_at = NOW()
             WHERE id = $3 AND user_id = $4
             RETURNING id, name, steps, created_at, updated_at`,
            [
                name === undefined ? null : name.trim(),
                steps === undefined ? null : JSON.stringify(steps),
                Number(req.params.id),
                req.user.id
            ]
        );

        if (!result.rows.length) {
            return res.status(404).json({ error: 'API test not found' });
        }

        return res.json(result.rows[0]);
    } catch {
        return res.status(500).json({ error: 'Failed to update API test' });
    }
}

async function deleteApiTest(req, res) {
    if (!validId(req.params.id)) {
        return res.status(400).json({ error: 'Invalid API test ID' });
    }

    try {
        const result = await db.query(
            'DELETE FROM api_tests WHERE id = $1 AND user_id = $2 RETURNING id',
            [Number(req.params.id), req.user.id]
        );

        if (!result.rows.length) {
            return res.status(404).json({ error: 'API test not found' });
        }

        return res.status(204).send();
    } catch {
        return res.status(500).json({ error: 'Failed to delete API test' });
    }
}

async function executeApiTest(req, res) {
    if (!validId(req.params.id)) {
        return res.status(400).json({ error: 'Invalid API test ID' });
    }

    try {
        const testResult = await db.query(
            'SELECT id, steps FROM api_tests WHERE id = $1 AND user_id = $2',
            [Number(req.params.id), req.user.id]
        );

        if (!testResult.rows.length) {
            return res.status(404).json({ error: 'API test not found' });
        }

        const startedAt = new Date();
        let execution;

        try {
            execution = await runApiTest(testResult.rows[0]);
        } catch (error) {
            if (
                error?.message?.startsWith('steps must') ||
                error?.message?.startsWith('Step ')
            ) {
                return res.status(400).json({ error: error.message });
            }

            return res.status(500).json({ error: 'API test execution failed' });
        }

        const finishedAt = new Date();

        const saved = await db.query(
            `INSERT INTO api_test_runs
                (api_test_id, user_id, status, results,
                 started_at, finished_at, duration_ms)
             VALUES ($1, $2, $3, $4::jsonb, $5, $6, $7)
             RETURNING id, api_test_id, status, results,
                       started_at, finished_at, duration_ms`,
            [
                testResult.rows[0].id,
                req.user.id,
                execution.status,
                JSON.stringify(execution.results),
                startedAt,
                finishedAt,
                execution.durationMs
            ]
        );

        return res.status(200).json({
            ...saved.rows[0],
            failed_step: execution.failedStep
        });
    } catch {
        return res.status(500).json({ error: 'Failed to execute API test' });
    }
}

async function listApiTestRuns(req, res) {
    if (!validId(req.params.id)) {
        return res.status(400).json({ error: 'Invalid API test ID' });
    }

    try {
        const owner = await db.query(
            'SELECT id FROM api_tests WHERE id = $1 AND user_id = $2',
            [Number(req.params.id), req.user.id]
        );

        if (!owner.rows.length) {
            return res.status(404).json({ error: 'API test not found' });
        }

        const result = await db.query(
            `SELECT id, api_test_id, status, results,
                    started_at, finished_at, duration_ms
             FROM api_test_runs
             WHERE api_test_id = $1 AND user_id = $2
             ORDER BY started_at DESC
             LIMIT 100`,
            [Number(req.params.id), req.user.id]
        );

        return res.json(result.rows);
    } catch {
        return res.status(500).json({ error: 'Failed to fetch API test history' });
    }
}

// Validate definitions without executing any outbound requests.
async function validateStepsOnly(steps) {
    try {
        validateTest({ steps });
    } catch (error) {
        error.code = 'INVALID_API_TEST';
        throw error;
    }
}
module.exports = {
    listApiTests,
    getApiTest,
    createApiTest,
    updateApiTest,
    deleteApiTest,
    executeApiTest,
    listApiTestRuns
};

