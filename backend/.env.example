# Server
PORT=5000
NODE_ENV=production

# Database (inside Docker Compose the host is the service name "db")
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pulseiq

# Auth: generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://pulseiq.example.com

# Set to 1 when running behind a reverse proxy that terminates HTTPS
TRUST_PROXY=1