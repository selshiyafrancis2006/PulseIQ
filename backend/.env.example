# Server
PORT=5000
NODE_ENV=production

# Database (inside Docker Compose the host is the service name "db")
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pulseiq

# Auth: generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Prometheus exporter authentication (optional; endpoint returns 503 when unset).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROMETHEUS_METRICS_TOKEN=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://pulseiq.example.com

# Set to 1 when running behind a reverse proxy that terminates HTTPS
TRUST_PROXY=1
# Allow HTTP/TCP monitors to target RFC1918 IPv4 and IPv6 ULA addresses.
# Enable only for trusted self-hosted deployments. Defaults to disabled.
PULSEIQ_ALLOW_PRIVATE_TARGETS=false

# Maximum number of monitor checks running simultaneously (1–50; default 5).
UPTIME_MAX_CONCURRENT_MONITORS=5

# Email notifications (optional; configure your SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Base64-encoded 32-byte key used to encrypt Slack and webhook URLs.
NOTIFICATION_ENCRYPTION_KEY=

# Metrics retention (days)
METRICS_RAW_RETENTION_DAYS=3
METRICS_ROLLUP_5M_RETENTION_DAYS=8
METRICS_ROLLUP_1H_RETENTION_DAYS=90
ANOMALY_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=7

# Monitor check history retention (days)
MONITOR_RESULTS_RETENTION_DAYS=35
MONITOR_ROLLUP_RETENTION_DAYS=400