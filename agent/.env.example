# Base URL of your PulseIQ backend (use https:// in production)
BACKEND_URL=https://pulseiq.example.com

# API key shown once when you register this host in PulseIQ
API_KEY=

# Optional: how often to send metrics, in milliseconds (minimum 1000)
INTERVAL_MS=5000
# Optional: how many samples the agent keeps while the backend is unreachable
# (default 100; the oldest waiting sample is dropped and logged when full)
QUEUE_MAX_SIZE=100
# Optional: unsent samples are saved to a file so they survive a restart.
# Default: queue.json next to collector.js. In Docker, point this at a mounted
# volume (for example /data/queue.json) or the file is lost with the container.
# Set QUEUE_PERSIST=false to keep the queue in memory only.
# QUEUE_FILE=queue.json
# QUEUE_PERSIST=true
# Optional: how often to send this host's busiest processes, in milliseconds
# (default 30000, minimum 5000). Set to 0 to turn process reporting off.
# PROCESS_INTERVAL_MS=30000
